# Application Port
PORT=3001

# Supabase Credentials
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# Redis Config (Used by BullMQ for background jobs)
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================================================
# Meta / WhatsApp API Credentials
# ==============================================================================

# Public App ID (Found in Meta App Dashboard -> Basic Settings)
FACEBOOK_APP_ID=your_facebook_app_id_here

# SECRET App Key (Found in Meta App Dashboard -> Basic Settings)
# WARNING: NEVER expose this to the frontend. NEVER commit this value to git!
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# Embedded Signup Config ID (Found in Meta App Dashboard -> WhatsApp -> Embedded Signup)
WHATSAPP_CONFIG_ID=your_whatsapp_config_id_here

# Comma-separated list of allowed CORS origins.
# Local dev defaults to localhost:3000/3002; set this to the deployed
# frontend URL in production, e.g. https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000,https://localhost:3000,http://localhost:3002,https://localhost:3002
