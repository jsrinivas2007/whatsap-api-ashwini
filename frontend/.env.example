# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API origin.
# Local dev: http://localhost:3001 (the Next.js rewrite proxies /api/* to it).
# Production (Vercel): set to the deployed backend URL,
# e.g. https://your-backend.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:3001

# Meta / WhatsApp Embedded Signup (public values, used client-side)
NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=your_whatsapp_config_id

# Meta Webhook Verification Token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_secure_verify_token_here
